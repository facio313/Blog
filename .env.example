# Copy to .env only on the development or deployment host. Never commit real values.
# Resolve both values with scripts/portfolio-auth-mode.sh. main/dev require sso;
# every other branch requires local, and packaged/container runs must set both.
PORTFOLIO_BRANCH=
PORTFOLIO_AUTH_MODE=

# Production deploys require the exact lowercase 40-character commit SHA.
BLOG_IMAGE_TAG=

# The RPi uses a dedicated database and login role in the shared, unexposed cksDB service.
BLOG_DATABASE_URL=postgresql://blog:REPLACE_WITH_DATABASE_PASSWORD@cksDB:5432/blog
BLOG_PUBLIC_BASE_URL=https://bonifacio.work/blog
BLOG_LOG_LEVEL=info
