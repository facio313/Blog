# Copy to .env only on the development or deployment host. Never commit real values.
# Resolve both values with scripts/portfolio-auth-mode.sh. main/dev require sso;
# every other branch requires local, and packaged/container runs must set both.
PORTFOLIO_BRANCH=
PORTFOLIO_AUTH_MODE=

# Production deploys require the exact lowercase 40-character commit SHA.
BLOG_IMAGE_TAG=

# The RPi uses a dedicated database and login role in the shared, unexposed cksDB service.
BLOG_DATABASE_URL=postgresql://blog:REPLACE_WITH_DATABASE_PASSWORD@cksDB:5432/blog
BLOG_PUBLIC_BASE_URL=https://bonifacio.work/blog
BLOG_LOG_LEVEL=info

# The only central Bonifacio username allowed to write. Email/display name are not used.
BLOG_AUTHOR_USERNAME=cks
# Native local development only: requires a non-main/dev branch, NODE_ENV!=production,
# BLOG_HOST=127.0.0.1 and a loopback BLOG_PUBLIC_BASE_URL. Disabled by default.
BLOG_LOCAL_AUTHOR=false
# Operator-managed edge secret. Prefer the file-backed docker-compose.author.yml overlay;
# its host file and Nginx snippet are produced together by Bonifacio sync_edge_secrets.py blog.
# Never put a real secret in this example or commit the private .env file.
BLOG_SSO_EDGE_SECRET=
BLOG_SSO_EDGE_SECRET_FILE=
BLOG_SSO_EDGE_SECRET_HOST_FILE=/home/cks/.config/blog/sso-edge-secret
