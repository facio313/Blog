{
  "name": "@bonifacio/blog-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup src/server.ts src/scripts/bundle-content.ts --format esm --platform node --target node22 --out-dir dist --clean",
    "content:bundle": "tsx src/scripts/bundle-content.ts",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "@fastify/helmet": "13.0.2",
    "cheerio": "1.1.2",
    "fastify": "5.12.1",
    "highlight.js": "11.12.0",
    "js-yaml": "5.3.0",
    "marked": "16.3.0",
    "marked-highlight": "2.2.2",
    "pg": "8.16.3",
    "sanitize-html": "2.17.7",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/node": "22.18.1",
    "@types/pg": "8.15.5",
    "@types/sanitize-html": "2.16.0",
    "@types/js-yaml": "4.0.9",
    "tsx": "4.20.5",
    "tsup": "8.5.0",
    "typescript": "5.9.2",
    "vitest": "3.2.7"
  }
}
